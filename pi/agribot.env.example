# Copy to pi/agribot.env (git-ignored). install.sh copies it to /etc/agribot.env,
# which the running service reads.
# Never commit the real robot key.

# Backend. The app can also send its server address over Bluetooth when it
# shares a network; that value is saved in STATE_FILE and takes priority.
# Hosted backend on Render (or http://LAPTOP-IP:5001 for local testing).
AGRIBOT_BACKEND_URL=https://agribot-egl8.onrender.com
# Must equal ROBOT_INGEST_KEY on the server. Any characters are fine; quotes optional.
ROBOT_INGEST_KEY=replace-with-the-same-key-as-the-server
ROBOT_LATITUDE=19.047838
ROBOT_LONGITUDE=72.872712
PUBLISH_INTERVAL_SECONDS=30
HEARTBEAT_SECONDS=3
STATE_FILE=/var/lib/agribot/state.json

# Local diagnostics API.
AGRIBOT_HOST=0.0.0.0
AGRIBOT_PORT=8000

# Local API token. Arm motion endpoints accept requests from the Pi itself, or
# from the LAN only with header X-AgriBot-Token: <this value>. Empty = Pi only.
AGRIBOT_LOCAL_TOKEN=

# --- Pi sensors -------------------------------------------------------------
# true = labelled demo values with no hardware (laptop testing). Anything else
# uses the real sensors; a failed sensor is reported as unavailable, never faked.
SIMULATE_SENSORS=auto
SENSOR_READ_SECONDS=5
# DHT22 data pin (BCM). NOTE: GPIO24 is also the 'dc' line of the 3.5" SPI LCD
# overlay in /boot/firmware/config.txt; both cannot use it (docs/COMMISSIONING.md).
DHT_PIN=24
# auto = kernel driver if dtoverlay=dht11,gpiopin=N is loaded, else Python bit-bang.
DHT_BACKEND=auto
# Last good DHT22 value may be reused (labelled "stale") for this long.
DHT_STALE_SECONDS=300
# DEMO ONLY (opt-in): with DHT_BACKEND=none AND SENSOR_DEMO_MODE=true the service
# generates plausible temperature/humidity, labelled "simulated" everywhere
# (/sensors, /status, app "Sensors: demo ...", robot.status stored with each
# reading). Never used for automation. Ignored while DHT_BACKEND is not none.
SENSOR_DEMO_MODE=false
RAIN_ENABLED=true
RAIN_DO_PIN=27
RAIN_WET_DIGITAL_VALUE=0

# Soil moisture: none (not installed yet) | digital | mcp3008 | esp32
SOIL_SENSOR=none
# The backend requires a soil number in every reading. While no sensor exists,
# this placeholder is sent and labelled "placeholder" on the Pi (/sensors, status).
# Set to none to stop publishing until a real sensor is installed.
SOIL_PLACEHOLDER_PERCENT=48
# digital: wet/dry DO pin.  mcp3008: channel + 0..1 values.  esp32: millivolts at ESP32 GPIO35.
SOIL_DIGITAL_PIN=
SOIL_WET_DIGITAL_VALUE=0
SOIL_ADC_CHANNEL=0
SOIL_DRY_VALUE=0.75
SOIL_WET_VALUE=0.35

# --- ESP32 (USB serial): pH probe ADC + probe arm ----------------------------
# Only enable after flashing esp32/agribot_esp32 (an unknown sketch could treat
# serial text as servo commands; the Pi only sends PING until it identifies).
ESP32_ENABLED=false
ESP32_PORT=auto
ESP32_BAUD=115200

# pH: esp32 | none. Default: esp32 when ESP32_ENABLED=true. There is no fixed or
# demo pH: without a valid calibrated measurement the app/backend get null.
PH_SOURCE=
# Two or more "pH:mV" points measured in buffer solutions AT THE ESP32 PIN.
# Empty = uncalibrated: raw ADC + voltage are reported, no pH is published.
PH_CALIBRATION=
# Optional, before calibration: the board's DOCUMENTED output at pH 7 (mV at the
# ESP32 pin, after any divider) and its slope in mV per +1 pH (usually negative).
# Only copy these from the board's datasheet; they give an "uncalibrated"
# estimate shown on the Pi (/ph, /sensors) and never sent to the app/backend.
PH_PROVISIONAL_NEUTRAL_MV=
PH_PROVISIONAL_MV_PER_PH=
PH_SETTLE_SECONDS=20
PH_SAMPLES=5
PH_SAMPLE_INTERVAL_SECONDS=1
# A probe measurement older than this is no longer published.
PH_MAX_AGE_SECONDS=3600

# Arm: disabled (no motion, default) | manual (neutral test/jog/home/retract for
# commissioning) | auto (also insert + full pH measurement). See docs/COMMISSIONING.md.
ARM_MODE=disabled
# Set true ONLY after stop values, directions, travel limits and emergency stop
# were verified on the real arm. auto mode refuses to move without it.
ARM_COMMISSIONED=false
# Provisional neutral (stop) values, servo "angle" units 70..110. Never swap them.
ARM_SERVO1_STOP=96
ARM_SERVO2_STOP=92
# 1 or -1: flip if a positive jog moves the wrong way (re-home afterwards).
ARM_SERVO1_DIR=1
ARM_SERVO2_DIR=1
# Manual jog caps (firmware additionally caps unhomed jogs at 40 % / 400 ms).
ARM_JOG_MAX_MS=300
ARM_JOG_MAX_SPEED=30
# App "Arm Up / Arm Down" (Drive screen): servo 1 = elbow, servo 2 = wrist, both
# moved together; the shoulder is never commanded. Up = elbow ARM_UP_ELBOW_DIR and
# wrist ARM_UP_WRIST_DIR (opposite by default); Down reverses both. Directions are
# NOT commissioned yet: verify and flip these on the bench (docs/COMMISSIONING.md 5.7).
# Needs ARM_MODE=manual|auto, ARM_APP_CONTROL=true and AGRIBOT_LOCAL_TOKEN (typed into the app).
ARM_APP_CONTROL=false
ARM_UP_ELBOW_DIR=1
ARM_UP_WRIST_DIR=-1
# One nudge: % speed and ms (capped by ARM_JOG_MAX_SPEED / ARM_JOG_MAX_MS).
ARM_NUDGE_SPEED=20
ARM_NUDGE_MS=250
# Measured during commissioning (estimate units = ms at 100 % speed, home = 0).
ARM_AXIS1_LIMITS=
ARM_AXIS2_LIMITS=
# Insert sequence from the retracted pose: axis:speed:ms,...
ARM_INSERT_STEPS=
ARM_RETRACT_SPEED=30
# Refuse to drive while the probe may be in the soil.
DRIVE_INTERLOCK=true

# Crop-disease vision. Copy ai/models/weights/best.onnx to the Pi.
MODEL_PATH=../ai/models/weights/best.onnx
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# auto | picamera | usb | none
CAMERA=auto
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=960
# Scan automatically every N seconds (0 = only when the app asks).
AUTO_SCAN_INTERVAL_SECONDS=900

# Driving: L298N pins (BCM) from docs/PINOUT.md. Speed is PWM on IN1-IN4 and the
# enable pins are held high (ENA/ENB jumpers removed, as wired on the robot).
DRIVE_ENABLED=true
MOTOR_LEFT_FORWARD_PIN=5
MOTOR_LEFT_BACKWARD_PIN=6
MOTOR_RIGHT_FORWARD_PIN=16
MOTOR_RIGHT_BACKWARD_PIN=26
MOTOR_LEFT_ENABLE_PIN=12
MOTOR_RIGHT_ENABLE_PIN=13
# 0.1-1.0; lower it for gentler first tests.
DRIVE_MAX_SPEED=1.0
# Motors stop if the app goes quiet this long (200-5000).
DRIVE_TIMEOUT_MS=600
# PS5 controller: left stick or R2/L2 = drive, right stick = steer, Circle = stop.
GAMEPAD_ENABLED=true
GAMEPAD_DEADZONE=0.12

# Bluetooth Wi-Fi sharing.
BLE_ENABLED=true
BLE_NAME=AgriBot
# Optional 4-8 digit PIN the app must send before the Pi accepts a network.
BLE_PAIRING_PIN=
WIFI_INTERFACE=wlan0
