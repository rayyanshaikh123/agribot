# Copy to pi/agribot.env (git-ignored). install.sh copies it to /etc/agribot.env,
# which the running service reads.
# Never commit the real robot key.

# Backend. The app can also send its server address over Bluetooth when it
# shares a network; that value is saved in STATE_FILE and takes priority.
# Hosted backend on Render (or http://LAPTOP-IP:5001 for local testing).
AGRIBOT_BACKEND_URL=https://agribot-egl8.onrender.com
# Must equal ROBOT_INGEST_KEY on the server. Any characters are fine; quotes optional.
ROBOT_INGEST_KEY=replace-with-the-same-key-as-the-server
ROBOT_LATITUDE=19.047838
ROBOT_LONGITUDE=72.872712
PUBLISH_INTERVAL_SECONDS=30
HEARTBEAT_SECONDS=3
STATE_FILE=/var/lib/agribot/state.json

# Local diagnostics API.
AGRIBOT_HOST=0.0.0.0
AGRIBOT_PORT=8000

# Sensors: auto = use hardware when the GPIO libraries load, else simulate.
SIMULATE_SENSORS=auto
DHT_PIN=24
SOIL_ADC_CHANNEL=0
RAIN_DO_PIN=27
PH_ADC_CHANNEL=2
RAIN_WET_DIGITAL_VALUE=0
SOIL_DRY_VALUE=0.75
SOIL_WET_VALUE=0.35
# Demo values until the analog probes are wired and calibrated.
USE_FAKE_SOIL_MOISTURE=true
FAKE_SOIL_MOISTURE=48
USE_FAKE_PH=true
FAKE_PH=6.8

# Crop-disease vision. Copy ai/models/weights/best.onnx to the Pi.
MODEL_PATH=../ai/models/weights/best.onnx
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# auto | picamera | usb | none
CAMERA=auto
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=960
# Scan automatically every N seconds (0 = only when the app asks).
AUTO_SCAN_INTERVAL_SECONDS=900

# Driving: L298N pins (BCM) from docs/PINOUT.md. With the ENA/ENB jumper caps
# left on, the enable pins are just unconnected and speed is PWM on IN1-IN4.
DRIVE_ENABLED=true
MOTOR_LEFT_FORWARD_PIN=5
MOTOR_LEFT_BACKWARD_PIN=6
MOTOR_RIGHT_FORWARD_PIN=16
MOTOR_RIGHT_BACKWARD_PIN=26
MOTOR_LEFT_ENABLE_PIN=12
MOTOR_RIGHT_ENABLE_PIN=13
# 0.1-1.0; lower it for gentler first tests.
DRIVE_MAX_SPEED=1.0
# Motors stop if the app goes quiet this long.
DRIVE_TIMEOUT_MS=600
# PS5 controller: left stick or R2/L2 = drive, right stick = steer, Circle = stop.
GAMEPAD_ENABLED=true
GAMEPAD_DEADZONE=0.12

# Bluetooth Wi-Fi sharing.
BLE_ENABLED=true
BLE_NAME=AgriBot
# Optional 4-8 digit PIN the app must send before the Pi accepts a network.
BLE_PAIRING_PIN=
WIFI_INTERFACE=wlan0
